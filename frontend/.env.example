# Departmental Store Management - Frontend Environment Configuration

# Operating Mode:
# Set to 'true' to run fully self-contained in high-fidelity demo mode with local persistence
# Set to 'false' to connect to a live FastAPI / Supabase backend
VITE_DEMO_MODE=true

# Store Information
VITE_STORE_NAME=Royal Mart
VITE_STORE_LOCATION="Chennai, Tamil Nadu"

# Production Backend API URL (leave blank for local development proxy or when using demo mode)
# When deploying FastAPI separately on Render, Railway, Fly.io, or AWS, set this to your backend domain:
# e.g. VITE_API_BASE_URL=https://merchant-api.example.com
VITE_API_BASE_URL=

# Supabase Client Configuration (Optional - for future direct client integration)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
